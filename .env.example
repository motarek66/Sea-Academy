# Openverse needs no key — it's queried by default.

# Get a free key at https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Google Custom Search JSON API — needs BOTH values:
# 1. API key: https://console.cloud.google.com/apis/credentials (enable "Custom Search API")
# 2. Search engine ID (cx): create one at https://programmablesearchengine.google.com/
#    with "Image search" and "Search the entire web" turned on.
GOOGLE_API_KEY=
GOOGLE_CX=
